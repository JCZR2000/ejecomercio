rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
                            && request.resource.size < 2 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
    }

    match /catalogo/{fileName} {
      allow get: if true;
      allow create, update: if request.auth != null
                            && fileName == request.auth.uid + '.json'
                            && request.resource.size < 1024 * 1024
                            && request.resource.contentType == 'application/json';
      allow delete: if request.auth != null && fileName == request.auth.uid + '.json';
    }

    // Fase 17: perfil de cobro público de la tienda (nombre, color, logo, WhatsApp y métodos de pago)
    match /perfil/{fileName} {
      allow get: if true;
      allow create, update: if request.auth != null
                            && fileName == request.auth.uid + '.json'
                            && request.resource.size < 64 * 1024
                            && request.resource.contentType == 'application/json';
      allow delete: if request.auth != null && fileName == request.auth.uid + '.json';
    }

    // Fase 17: nombre corto de la vitrina. create solo si no existe: el primero que lo pide se lo queda.
    match /tienda/{fileName} {
      allow get: if true;
      allow create: if request.auth != null
                    && fileName.matches('^[a-z0-9][a-z0-9-]{1,28}[a-z0-9][.]json$')
                    && request.resource.metadata.owner == request.auth.uid
                    && request.resource.size < 1024
                    && request.resource.contentType == 'application/json';
      allow update: if false;
      allow delete: if request.auth != null && resource.metadata.owner == request.auth.uid;
    }
  }
}
