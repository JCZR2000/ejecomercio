rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Fase 19: pedido que crea el cliente de la vitrina (sin sesión). Solo si el dueño lo abrió en publico/pedidos.
    // La app revisa cada línea de items al leer; aquí solo se limita la forma y el tamaño.
    function validOrder(userId) {
      let d = request.resource.data;
      let cfg = get(/databases/$(database)/documents/users/$(userId)/publico/pedidos).data;
      return cfg.abierto == true
        && d.keys().hasOnly(['v','name','phone','pay','delivery','address','items','at'])
        && d.keys().hasAll(['v','name','phone','pay','items','at'])
        && d.v == 1
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.phone is string && d.phone.matches('^[0-9]{7,15}$')
        && (d.pay == 'contado' || (d.pay == 'fiado' && cfg.fiado == true))
        && (!('delivery' in d) || d.delivery in ['retiro','delivery'])
        && (!('address' in d) || (d.address is string && d.address.size() <= 120))
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && d.at is timestamp
        && d.at > request.time - duration.value(10, 'm')
        && d.at < request.time + duration.value(10, 'm');
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /pedidos/{orderId} {
        allow create: if validOrder(userId);
      }

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
